# Copy to ~/.claude-guard/config.env after the customer names one leaf node.
# install.sh writes this file. Do not commit real node names.

CLAUDE_EXPECTED_NODE=''
CLAUDE_EXPECTED_REGION='TW'
CLAUDE_AI_GROUP='🤖 AI服务'
# Leave empty for ccg_detect.py auto-discovery. Override only with a verified controller socket.
CLAUDE_GUARD_MIHOMO_SOCKET=''
CLAUDE_GUARD_CLASH_CONFIG=''
CLAUDE_GUARD_PROXY_URL='http://127.0.0.1:7898'
CLAUDE_GUARD_PROBE_GRACE='90'
CLAUDE_TIMEZONE='Asia/Taipei'
